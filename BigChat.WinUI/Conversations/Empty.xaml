<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BigChat.Conversations.Empty"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conversations="using:BigChat.Conversations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messages="using:BigChat.Messages"
    xmlns:shared="using:BigChat.Utils"
    xmlns:viewmodel="using:BigChat.AppCore.ViewModel"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <Grid MaxWidth="1024" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="InputBox"
                    MinHeight="34"
                    MaxHeight="200"
                    AcceptsReturn="True"
                    PlaceholderText="{x:Bind Loc.InputBoxPlaceholderText, Mode=OneWay}"
                    PreviewKeyDown="InputBox_PreviewKeyDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SendBtn"
                        Click="SendBtn_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                        <SymbolIcon Symbol="Send" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
