<?xml version="1.0" encoding="utf-8" ?>
<conversations:ReactiveConversationPage
    x:Class="BigChat.Conversations.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conversations="using:BigChat.Conversations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messages="using:BigChat.Messages"
    xmlns:shared="using:BigChat.Utils"
    xmlns:viewmodel="using:BigChat.AppCore.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ConversationViewModel}"
    mc:Ignorable="d">

    <conversations:ReactiveConversationPage.Resources>
        <messages:ChatTemplateSelector
            x:Key="ChatTemplateSelector"
            AssistantTemplate="{StaticResource AssistantDataTemplate}"
            UserTemplate="{StaticResource UserDataTemplate}" />
        <DataTemplate x:Key="UserDataTemplate" x:DataType="viewmodel:MessageViewModel">
            <messages:UserMessage ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="AssistantDataTemplate" x:DataType="viewmodel:MessageViewModel">
            <messages:AssistantMessage ViewModel="{x:Bind}" />
        </DataTemplate>
    </conversations:ReactiveConversationPage.Resources>

    <ListView
        x:Name="MessageListView"
        ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
        ItemsSource="{x:Bind Messages}"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        SelectionMode="None">
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="MaxWidth" Value="1024" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </ListView.ItemContainerStyle>
    </ListView>
</conversations:ReactiveConversationPage>
