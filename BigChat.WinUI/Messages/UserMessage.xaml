<?xml version="1.0" encoding="utf-8" ?>
<messages:ReactiveUserMessage
    x:Class="BigChat.Messages.UserMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messages="using:BigChat.Messages"
    xmlns:viewmodel="using:BigChat.AppCore.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MessageViewModel}"
    mc:Ignorable="d">

    <messages:ReactiveUserMessage.Resources>
        <Style x:Key="CardStyle" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </messages:ReactiveUserMessage.Resources>

    <Grid x:Name="ActionsGrid" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <TextBlock
                    HorizontalAlignment="Right"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBox
                x:Name="EditTextBox"
                Width="400"
                Height="100"
                MaxHeight="148"
                HorizontalAlignment="Right"
                AcceptsReturn="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay}" />
        </Grid>

        <StackPanel
            x:Name="ActionButtonsPanel"
            Grid.Row="1"
            Padding="0,4,0,4"
            HorizontalAlignment="Right"
            Background="Transparent"
            Opacity="0"
            Orientation="Horizontal"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
            <!--<Button Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="{ThemeResource SmallIconSize}" Glyph="&#xE777;" />
            </Button>-->
            <Button x:Name="EnableEditBtn" Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="{ThemeResource SmallIconSize}" Glyph="&#xE70F;" />
            </Button>
            <Button x:Name="CopyBtn" Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="{ThemeResource SmallIconSize}" Glyph="&#xE8C8;" />
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Padding="0,4,0,4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button x:Name="CancelEditBtn" Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="{ThemeResource SmallIconSize}" Glyph="&#xE711;" />
            </Button>
            <Button x:Name="ConfirmEditBtn" Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="{ThemeResource SmallIconSize}" Glyph="&#xE724;" />
            </Button>
        </StackPanel>
    </Grid>
</messages:ReactiveUserMessage>
