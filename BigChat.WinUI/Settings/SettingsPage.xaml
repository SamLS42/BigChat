<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BigChat.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BigChat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:BigChat.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Grid
        x:Name="RootGrid"
        MaxWidth="1024"
        Margin="32"
        RowSpacing="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            HorizontalAlignment="Left"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind Loc.SettingsText, Mode=OneWay}" />
        <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <settings:OllamaSettings />
                <!--<toolkit:SettingsExpander Header="Ollama configuration" IsExpanded="{x:Bind ViewModel.OllamaIsOn, Mode=OneWay}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.OllamaIsOn, Mode=TwoWay}" />
                    <toolkit:SettingsExpander.Items>
                        <settings:OllamaSettings />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander Header="Azure AI Inference configuration" IsExpanded="{x:Bind ViewModel.AzureAIInferenceIsOn, Mode=OneWay}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AzureAIInferenceIsOn, Mode=TwoWay}" />
                    <toolkit:SettingsExpander.Items>
                        <settings:AzureAIInferenceSettings />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
