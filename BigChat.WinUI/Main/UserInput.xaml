<?xml version="1.0" encoding="utf-8" ?>
<main:ReactiveUserInput
    x:Class="BigChat.Main.UserInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="using:BigChat.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <Grid MaxWidth="1024" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                MinHeight="34"
                MaxHeight="200"
                AcceptsReturn="True"
                PlaceholderText="{x:Bind Loc.InputBoxPlaceholderText, Mode=OneWay}"
                PreviewKeyDown="InputBox_PreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button x:Name="SendBtn">
                    <SymbolIcon Symbol="Send" />
                </Button>
                <Button x:Name="StopBtn">
                    <SymbolIcon Symbol="Stop" />
                </Button>
            </StackPanel>
        </Grid>

    </StackPanel>

</main:ReactiveUserInput>
