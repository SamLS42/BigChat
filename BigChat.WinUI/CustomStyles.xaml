<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:BigChat"
    xmlns:myConverters="using:BigChat.Converters">
    <myConverters:TwoDecimalConverter x:Key="TwoDecimalConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    <converters:EmptyStringToObjectConverter
        x:Key="EmptyStringToObjectConverter"
        EmptyValue="Visible"
        NotEmptyValue="Collapsed" />
    <Style x:Key="AssistantCardStyle" TargetType="Grid">
        <Setter Property="Padding" Value="12" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <x:Double x:Key="SmallIconSize">16</x:Double>
    <Style
        x:Key="TextBlockStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Width" Value="256" />
    </Style>
    <Style
        x:Key="PasswordBoxStyle"
        BasedOn="{StaticResource DefaultPasswordBoxStyle}"
        TargetType="PasswordBox">
        <Setter Property="Width" Value="256" />
    </Style>
    <Style
        x:Key="SmallerStep"
        BasedOn="{StaticResource DefaultSliderStyle}"
        TargetType="Slider">
        <Setter Property="SmallChange" Value="0.01" />
        <Setter Property="StepFrequency" Value="0.01" />
        <Setter Property="ThumbToolTipValueConverter" Value="{ThemeResource TwoDecimalConverter}" />
        <Setter Property="Width" Value="256" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="TickPlacement" Value="Outside" />
    </Style>
</ResourceDictionary>
